<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:padding="2dp">

    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent">

        <!-- Dynamic Rounded Blurred Cover / Theme Background -->
        <ImageView
            android:id="@+id/widget_dynamic_bg"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:scaleType="fitXY"
            android:contentDescription="@null" />

        <LinearLayout
            android:id="@+id/widget_inner"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:background="@drawable/bg_widget_glass_rounded"
            android:orientation="vertical"
            android:padding="14dp">

            <!-- Header Bar: Brand, Sound Quality Badge, Queue & Playlist Shortcuts -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/widget_brand_label"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:letterSpacing="0.14"
                    android:text="SONICLET"
                    android:textColor="#00E676"
                    android:textSize="10.5sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/widget_audio_badge"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="8dp"
                    android:background="#26FFFFFF"
                    android:paddingStart="7dp"
                    android:paddingEnd="7dp"
                    android:paddingTop="2dp"
                    android:paddingBottom="2dp"
                    android:text="HI-RES"
                    android:textColor="#FFFFFF"
                    android:textSize="9.5sp"
                    android:textStyle="bold" />

                <View
                    android:layout_width="0dp"
                    android:layout_height="1dp"
                    android:layout_weight="1" />

                <ImageView
                    android:id="@+id/widget_btn_queue"
                    android:layout_width="28dp"
                    android:layout_height="28dp"
                    android:padding="4dp"
                    android:scaleType="fitCenter"
                    android:src="@drawable/ic_widget_queue"
                    android:contentDescription="Open queue" />

                <ImageView
                    android:id="@+id/widget_btn_playlist"
                    android:layout_width="28dp"
                    android:layout_height="28dp"
                    android:layout_marginStart="4dp"
                    android:padding="4dp"
                    android:scaleType="fitCenter"
                    android:src="@drawable/ic_widget_playlist"
                    android:contentDescription="Open playlists" />

            </LinearLayout>

            <!-- Center: 74dp Album Art + Song Info + Favorite -->
            <LinearLayout
                android:id="@+id/widget_center_section"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <ImageView
                    android:id="@+id/widget_art"
                    android:layout_width="74dp"
                    android:layout_height="74dp"
                    android:scaleType="centerCrop"
                    android:contentDescription="Album artwork" />

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:layout_marginStart="12dp"
                    android:layout_marginEnd="6dp"
                    android:orientation="vertical">

                    <TextView
                        android:id="@+id/widget_title"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:ellipsize="end"
                        android:singleLine="true"
                        android:text="Soniclet Music"
                        android:textColor="#FFFFFF"
                        android:textSize="17sp"
                        android:textStyle="bold" />

                    <TextView
                        android:id="@+id/widget_artist"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="2dp"
                        android:ellipsize="end"
                        android:singleLine="true"
                        android:text="Tap to play"
                        android:textColor="#C2C2CA"
                        android:textSize="13.5sp" />

                    <TextView
                        android:id="@+id/widget_subtitle"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="2dp"
                        android:ellipsize="end"
                        android:singleLine="true"
                        android:text="Soniclet Library"
                        android:textColor="#8E8E96"
                        android:textSize="11.5sp" />

                </LinearLayout>

                <ImageView
                    android:id="@+id/widget_btn_fav"
                    android:layout_width="36dp"
                    android:layout_height="36dp"
                    android:padding="7dp"
                    android:scaleType="fitCenter"
                    android:src="@drawable/ic_favorite_border"
                    android:contentDescription="Favorite" />

            </LinearLayout>

            <!-- Live Waveform Progress + Timestamps -->
            <LinearLayout
                android:id="@+id/widget_progress_section"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:orientation="vertical">

                <FrameLayout
                    android:layout_width="match_parent"
                    android:layout_height="22dp">

                    <ImageView
                        android:id="@+id/widget_waveform"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:scaleType="fitXY"
                        android:contentDescription="Song progress" />

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:orientation="horizontal">

                        <View
                            android:id="@+id/widget_bar_seek_backward"
                            android:layout_width="0dp"
                            android:layout_height="match_parent"
                            android:layout_weight="1" />

                        <View
                            android:id="@+id/widget_bar_seek_forward"
                            android:layout_width="0dp"
                            android:layout_height="match_parent"
                            android:layout_weight="1" />
                    </LinearLayout>
                </FrameLayout>

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:orientation="horizontal">

                    <TextView
                        android:id="@+id/widget_time_elapsed"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="00:00"
                        android:textColor="#B0B0B8"
                        android:textSize="10.5sp" />

                    <View
                        android:layout_width="0dp"
                        android:layout_height="1dp"
                        android:layout_weight="1" />

                    <TextView
                        android:id="@+id/widget_time_total"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="00:00"
                        android:textColor="#B0B0B8"
                        android:textSize="10.5sp" />

                </LinearLayout>
            </LinearLayout>

            <!-- Full Transport Deck -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="1"
                android:layout_marginTop="6dp"
                android:gravity="center"
                android:orientation="horizontal">

                <ImageView
                    android:id="@+id/widget_btn_shuffle"
                    android:layout_width="32dp"
                    android:layout_height="32dp"
                    android:layout_weight="1"
                    android:padding="5dp"
                    android:scaleType="fitCenter"
                    android:src="@drawable/ic_shuffle_off"
                    android:contentDescription="Shuffle" />

                <ImageView
                    android:id="@+id/widget_btn_rewind"
                    android:layout_width="32dp"
                    android:layout_height="32dp"
                    android:layout_weight="1"
                    android:padding="5dp"
                    android:scaleType="fitCenter"
                    android:src="@drawable/ic_rewind_10"
                    android:contentDescription="Rewind 10 seconds" />

                <ImageView
                    android:id="@+id/widget_btn_prev"
                    android:layout_width="38dp"
                    android:layout_height="38dp"
                    android:layout_weight="1"
                    android:padding="6dp"
                    android:scaleType="fitCenter"
                    android:src="@drawable/ic_previous"
                    android:contentDescription="Previous song" />

                <ImageView
                    android:id="@+id/widget_btn_play"
                    android:layout_width="50dp"
                    android:layout_height="50dp"
                    android:layout_marginStart="4dp"
                    android:layout_marginEnd="4dp"
                    android:scaleType="fitCenter"
                    android:src="@drawable/ic_play"
                    android:contentDescription="Play or pause" />

                <ImageView
                    android:id="@+id/widget_btn_next"
                    android:layout_width="38dp"
                    android:layout_height="38dp"
                    android:layout_weight="1"
                    android:padding="6dp"
                    android:scaleType="fitCenter"
                    android:src="@drawable/ic_next"
                    android:contentDescription="Next song" />

                <ImageView
                    android:id="@+id/widget_btn_fast_forward"
                    android:layout_width="32dp"
                    android:layout_height="32dp"
                    android:layout_weight="1"
                    android:padding="5dp"
                    android:scaleType="fitCenter"
                    android:src="@drawable/ic_fast_forward_10"
                    android:contentDescription="Forward 10 seconds" />

                <ImageView
                    android:id="@+id/widget_btn_repeat"
                    android:layout_width="32dp"
                    android:layout_height="32dp"
                    android:layout_weight="1"
                    android:padding="5dp"
                    android:scaleType="fitCenter"
                    android:src="@drawable/ic_repeat_off"
                    android:contentDescription="Repeat" />

            </LinearLayout>
        </LinearLayout>
    </FrameLayout>
</FrameLayout>

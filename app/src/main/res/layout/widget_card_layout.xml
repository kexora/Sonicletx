<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:padding="2dp">

    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent">

        <!-- Dynamic Rounded Background -->
        <ImageView
            android:id="@+id/widget_dynamic_bg"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:scaleType="fitXY"
            android:contentDescription="@null" />

        <LinearLayout
            android:id="@+id/widget_inner"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:background="@drawable/bg_widget_amoled_rounded"
            android:orientation="vertical"
            android:padding="14dp">

            <!-- Top Row: Artwork + Metadata + Favorite -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <ImageView
                    android:id="@+id/widget_art"
                    android:layout_width="68dp"
                    android:layout_height="68dp"
                    android:scaleType="centerCrop"
                    android:contentDescription="Album artwork" />

                <LinearLayout
                    android:id="@+id/widget_info_container"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:layout_marginStart="12dp"
                    android:layout_marginEnd="8dp"
                    android:orientation="vertical">

                    <TextView
                        android:id="@+id/widget_title"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:ellipsize="end"
                        android:singleLine="true"
                        android:text="Soniclet Music"
                        android:textColor="#FFFFFF"
                        android:textSize="16sp"
                        android:textStyle="bold" />

                    <TextView
                        android:id="@+id/widget_artist"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="2dp"
                        android:ellipsize="end"
                        android:singleLine="true"
                        android:text="Tap to play"
                        android:textColor="#C2C2CA"
                        android:textSize="13sp" />

                    <TextView
                        android:id="@+id/widget_subtitle"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="1dp"
                        android:ellipsize="end"
                        android:singleLine="true"
                        android:text="Soniclet Library"
                        android:textColor="#8E8E96"
                        android:textSize="11sp" />

                </LinearLayout>

                <ImageView
                    android:id="@+id/widget_btn_fav"
                    android:layout_width="36dp"
                    android:layout_height="36dp"
                    android:padding="7dp"
                    android:scaleType="fitCenter"
                    android:src="@drawable/ic_favorite_border"
                    android:contentDescription="Favorite" />

            </LinearLayout>

            <!-- Sleek 4dp Progress Bar -->
            <FrameLayout
                android:id="@+id/widget_progress_container"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:layout_marginBottom="4dp">

                <ProgressBar
                    android:id="@+id/widget_progress"
                    style="?android:attr/progressBarStyleHorizontal"
                    android:layout_width="match_parent"
                    android:layout_height="4dp"
                    android:max="100"
                    android:progress="40"
                    android:progressBackgroundTint="#33FFFFFF"
                    android:progressTint="#00E676" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="14dp"
                    android:orientation="horizontal">

                    <View
                        android:id="@+id/widget_bar_seek_backward"
                        android:layout_width="0dp"
                        android:layout_height="match_parent"
                        android:layout_weight="1" />

                    <View
                        android:id="@+id/widget_bar_seek_forward"
                        android:layout_width="0dp"
                        android:layout_height="match_parent"
                        android:layout_weight="1" />
                </LinearLayout>
            </FrameLayout>

            <!-- Spacious Transport Controls -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="1"
                android:gravity="center"
                android:orientation="horizontal">

                <ImageView
                    android:id="@+id/widget_btn_shuffle"
                    android:layout_width="32dp"
                    android:layout_height="32dp"
                    android:layout_weight="1"
                    android:padding="6dp"
                    android:scaleType="fitCenter"
                    android:src="@drawable/ic_shuffle_off"
                    android:contentDescription="Shuffle" />

                <ImageView
                    android:id="@+id/widget_btn_rewind"
                    android:layout_width="32dp"
                    android:layout_height="32dp"
                    android:layout_weight="1"
                    android:padding="6dp"
                    android:scaleType="fitCenter"
                    android:src="@drawable/ic_rewind_10"
                    android:contentDescription="Rewind 10 seconds" />

                <ImageView
                    android:id="@+id/widget_btn_prev"
                    android:layout_width="36dp"
                    android:layout_height="36dp"
                    android:layout_weight="1"
                    android:padding="6dp"
                    android:scaleType="fitCenter"
                    android:src="@drawable/ic_previous"
                    android:contentDescription="Previous song" />

                <ImageView
                    android:id="@+id/widget_btn_play"
                    android:layout_width="46dp"
                    android:layout_height="46dp"
                    android:layout_marginStart="4dp"
                    android:layout_marginEnd="4dp"
                    android:scaleType="fitCenter"
                    android:src="@drawable/ic_play"
                    android:contentDescription="Play or pause" />

                <ImageView
                    android:id="@+id/widget_btn_next"
                    android:layout_width="36dp"
                    android:layout_height="36dp"
                    android:layout_weight="1"
                    android:padding="6dp"
                    android:scaleType="fitCenter"
                    android:src="@drawable/ic_next"
                    android:contentDescription="Next song" />

                <ImageView
                    android:id="@+id/widget_btn_fast_forward"
                    android:layout_width="32dp"
                    android:layout_height="32dp"
                    android:layout_weight="1"
                    android:padding="6dp"
                    android:scaleType="fitCenter"
                    android:src="@drawable/ic_fast_forward_10"
                    android:contentDescription="Forward 10 seconds" />

                <ImageView
                    android:id="@+id/widget_btn_repeat"
                    android:layout_width="32dp"
                    android:layout_height="32dp"
                    android:layout_weight="1"
                    android:padding="6dp"
                    android:scaleType="fitCenter"
                    android:src="@drawable/ic_repeat_off"
                    android:contentDescription="Repeat" />

            </LinearLayout>
        </LinearLayout>
    </FrameLayout>
</FrameLayout>
